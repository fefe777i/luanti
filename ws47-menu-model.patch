diff --git a/builtin/mainmenu/ws47_theme.lua b/builtin/mainmenu/ws47_theme.lua
index d198049..e8e98b7 100755
--- a/builtin/mainmenu/ws47_theme.lua
+++ b/builtin/mainmenu/ws47_theme.lua
@@ -17,3 +17,28 @@ ws47_theme.STYLE_PREFIX = table.concat({
 	"style_type[checkbox;textcolor=#e8d9ff]",
 	"style_type[textarea;textcolor=#e8d9ff]",
 })
+
+
+-- Path of the skin the player picked (falls back to the default skin).
+function ws47_theme.get_skin_path()
+	local full = core.settings:get("ws47_skin_fullpath")
+	if full and full ~= "" then
+		local f = io.open(full, "rb")
+		if f then
+			f:close()
+			return full
+		end
+	end
+	return defaulttexturedir .. "skins" .. DIR_DELIM .. "character.png"
+end
+
+-- model[] element with the player model wearing the given (or chosen) skin.
+-- Drag with the mouse/finger to rotate it.
+function ws47_theme.player_model(x, y, w, h, skin_path)
+	return table.concat({
+		"model[", x, ",", y, ";", w, ",", h, ";ws47_player;",
+		core.formspec_escape(defaulttexturedir .. "character.b3d"), ";",
+		core.formspec_escape(skin_path or ws47_theme.get_skin_path()),
+		";0,180;false;true;0,79;30]",
+	})
+end
