diff --git a/src/client/dimensionhost.cpp b/src/client/dimensionhost.cpp
new file mode 100644
index 0000000..4a4d19c
--- /dev/null
+++ b/src/client/dimensionhost.cpp
@@ -0,0 +1,268 @@
+// Luanti
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include "dimensionhost.h"
+#include "clientmedia.h"
+#include "dimension.h"
+#include "exceptions.h"
+#include "log.h"
+#include "network/address.h"
+#include "network/networkexceptions.h"
+#include "network/socket.h"
+#include "server.h"
+#include "settings.h"
+#include "util/string.h"
+
+namespace {
+
+Address makeBindAddress(u16 port)
+{
+	Address addr(0, 0, 0, 0, port);
+	if (g_settings->getBool("ipv6_server"))
+		addr.setAddress(static_cast<IPv6AddressBytes *>(nullptr));
+	const std::string bind_str = g_settings->get("bind_address");
+	try {
+		addr.Resolve(bind_str.c_str());
+	} catch (const ResolveError &e) {
+		warningstream << "Resolving bind address \"" << bind_str
+			<< "\" failed: " << e.what()
+			<< " -- Listening on all addresses." << std::endl;
+	}
+	return addr;
+}
+
+bool isPortFree(u16 port)
+{
+	try {
+		Address addr = makeBindAddress(port);
+		UDPSocket socket(addr.isIPv6());
+		socket.Bind(addr);
+		return true;
+	} catch (const std::exception &) {
+		return false;
+	}
+}
+
+}
+
+DimensionHost::DimensionHost(const std::string &world_path,
+		const SubgameSpec &gamespec, u16 base_port) :
+	m_world_path(world_path),
+	m_gamespec(gamespec),
+	m_base_port(base_port),
+	m_next_port(base_port + 1)
+{
+}
+
+DimensionHost::~DimensionHost()
+{
+	stop();
+}
+
+u16 DimensionHost::getPort(const std::string &dimension) const
+{
+	std::lock_guard<std::mutex> lock(m_mutex);
+	auto it = m_ports.find(dimension);
+	return it == m_ports.end() ? 0 : it->second;
+}
+
+u16 DimensionHost::allocatePort()
+{
+	// m_mutex is not held here (only called by the starting thread)
+	for (int i = 0; i < 200; i++) {
+		u16 port = m_next_port++;
+		if (m_next_port == 0)
+			m_next_port = 1024;
+		bool used = false;
+		{
+			std::lock_guard<std::mutex> lock(m_mutex);
+			for (const auto &it : m_ports)
+				used |= (it.second == port);
+		}
+		if (!used && isPortFree(port))
+			return port;
+	}
+	return 0;
+}
+
+void DimensionHost::publishSetting()
+{
+	// "dimension_servers = overworld=30000, nether=30001" (read by
+	// core.travel_to_dimension)
+	std::string value;
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		for (const auto &it : m_ports) {
+			if (!value.empty())
+				value += ", ";
+			value += it.first + "=" + std::to_string(it.second);
+		}
+	}
+	g_settings->set("dimension_servers", value);
+}
+
+bool DimensionHost::startServer(const std::string &dimension, std::string &error)
+{
+	const bool is_main = (dimension == dimension::DEFAULT_NAME);
+	u16 port = is_main ? m_base_port : allocatePort();
+	if (port == 0) {
+		error = "no free port for the dimension \"" + dimension + "\"";
+		return false;
+	}
+
+	std::unique_ptr<Server> server;
+	try {
+		server = std::make_unique<Server>(m_world_path, m_gamespec, false,
+				makeBindAddress(port), false, nullptr, &m_shutdown_message,
+				dimension);
+		// Only one server announces the world to the server list
+		server->setMasterAnnounce(is_main);
+		server->setDimensionCreatedCallback(
+				[this](const std::string &name) { queueDimension(name); });
+		server->setStepSettings(Server::StepSettings{1.0f / 60.0f, false});
+		server->start();
+	} catch (const std::exception &e) {
+		error = std::string("dimension \"") + dimension + "\": " + e.what();
+		errorstream << "DimensionHost: " << error << std::endl;
+		return false;
+	}
+
+	if (is_main)
+		copyMediaToClientCache(server.get());
+
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		m_ports[dimension] = port;
+		m_servers[dimension] = std::move(server);
+	}
+	publishSetting();
+	actionstream << "DimensionHost: dimension \"" << dimension
+		<< "\" listens on port " << port << std::endl;
+	return true;
+}
+
+void DimensionHost::copyMediaToClientCache(Server *server)
+{
+	// Lets the host's own client skip downloading media it can read from disk
+	u32 n = 0;
+	for (auto &it : server->getMediaList()) {
+		if (it.first.size() == 20 && clientMediaUpdateCacheCopy(it.first, it.second))
+			n++;
+	}
+	infostream << "Copied " << n << " files directly from server to client cache"
+		<< std::endl;
+}
+
+void DimensionHost::queueDimension(const std::string &dimension)
+{
+	// May be called from a server thread: only queue, the worker starts it
+	std::lock_guard<std::mutex> lock(m_mutex);
+	if (m_stopping || !m_started || m_known.count(dimension))
+		return;
+	m_known.insert(dimension);
+	m_queue.push_back(dimension);
+	m_cond.notify_one();
+}
+
+bool DimensionHost::start(std::string &error)
+{
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		m_known.insert(dimension::DEFAULT_NAME);
+	}
+
+	m_had_old_setting = g_settings->getNoEx("dimension_servers", m_old_setting);
+	m_setting_saved = true;
+
+	if (!startServer(dimension::DEFAULT_NAME, error)) {
+		stop();
+		return false;
+	}
+
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		m_started = true;
+	}
+	// Dimensions that already exist, or were created by mods while the main
+	// one was loading
+	for (const std::string &name : dimension::list(m_world_path))
+		queueDimension(name);
+
+	m_worker = std::thread([this] { workerMain(); });
+	return true;
+}
+
+void DimensionHost::workerMain()
+{
+	while (true) {
+		std::string dimension;
+		{
+			std::unique_lock<std::mutex> lock(m_mutex);
+			m_cond.wait(lock, [this] { return m_stopping || !m_queue.empty(); });
+			if (m_stopping)
+				return;
+			dimension = m_queue.front();
+			m_queue.pop_front();
+		}
+		std::string error;
+		if (!startServer(dimension, error))
+			errorstream << "DimensionHost: could not start " << error << std::endl;
+	}
+}
+
+void DimensionHost::step()
+{
+	std::vector<Server *> servers;
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		for (auto &it : m_servers)
+			servers.push_back(it.second.get());
+	}
+	for (Server *server : servers)
+		server->step();
+}
+
+bool DimensionHost::isShutdownRequested() const
+{
+	std::lock_guard<std::mutex> lock(m_mutex);
+	for (const auto &it : m_servers) {
+		if (it.second->isShutdownRequested())
+			return true;
+	}
+	return false;
+}
+
+void DimensionHost::stop()
+{
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		m_stopping = true;
+		m_cond.notify_all();
+	}
+	if (m_worker.joinable())
+		m_worker.join();
+
+	std::map<std::string, std::unique_ptr<Server>> servers;
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		servers.swap(m_servers);
+		m_ports.clear();
+	}
+
+	// Stop the other dimensions first, the main one last
+	for (auto it = servers.begin(); it != servers.end();) {
+		if (it->first != dimension::DEFAULT_NAME)
+			it = servers.erase(it);
+		else
+			++it;
+	}
+	servers.clear();
+
+	if (g_settings && m_setting_saved) {
+		if (m_had_old_setting)
+			g_settings->set("dimension_servers", m_old_setting);
+		else
+			g_settings->remove("dimension_servers");
+	}
+	m_setting_saved = false;
+}
diff --git a/src/client/dimensionhost.h b/src/client/dimensionhost.h
new file mode 100644
index 0000000..4b4d56d
--- /dev/null
+++ b/src/client/dimensionhost.h
@@ -0,0 +1,86 @@
+// Luanti
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#pragma once
+
+#include "irrlichttypes.h"
+#include "content/subgames.h"
+#include <condition_variable>
+#include <deque>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <set>
+#include <string>
+#include <thread>
+
+class Server;
+
+/*
+	Runs one server per dimension of a hosted world ("Host game" button).
+
+	All servers live in this process, open the same world folder (players,
+	inventories and privileges are shared) and each one loads the map of its
+	own dimension, so different players can be in different dimensions at the
+	same time. The main dimension ("overworld") listens on the port chosen in
+	the menu, every other dimension on the next free port after it. The
+	"dimension_servers" setting is kept up to date, so core.travel_to_dimension()
+	sends players to the right server. Dimensions created while the game is
+	running (/newdimension, mods) get their server automatically.
+
+	The host's own client connects like any other client, so the servers
+	outlive game restarts and the host can move between dimensions without
+	stopping anybody else's server.
+*/
+class DimensionHost
+{
+public:
+	DimensionHost(const std::string &world_path, const SubgameSpec &gamespec,
+			u16 base_port);
+	~DimensionHost();
+
+	// Starts the main dimension and then the others in the background.
+	// Returns false (and sets `error`) when the main dimension failed to start.
+	bool start(std::string &error);
+	// Stops all servers (blocks until the worlds are saved)
+	void stop();
+
+	u16 getMainPort() const { return m_base_port; }
+	// 0 when the dimension has no (running) server
+	u16 getPort(const std::string &dimension) const;
+
+	// Called every frame by the game: rethrows fatal server errors
+	void step();
+	bool isShutdownRequested() const;
+
+	// Message of the servers' shutdown errors (empty if none)
+	const std::string &getShutdownMessage() const { return m_shutdown_message; }
+
+private:
+	bool startServer(const std::string &dimension, std::string &error);
+	void queueDimension(const std::string &dimension);
+	void workerMain();
+	u16 allocatePort();
+	void publishSetting();
+	void copyMediaToClientCache(Server *server);
+
+	std::string m_world_path;
+	SubgameSpec m_gamespec;
+	u16 m_base_port;
+	u16 m_next_port;
+
+	mutable std::mutex m_mutex;
+	std::map<std::string, std::unique_ptr<Server>> m_servers;
+	std::map<std::string, u16> m_ports;
+	std::set<std::string> m_known; // started or queued
+	std::deque<std::string> m_queue;
+	std::condition_variable m_cond;
+	std::thread m_worker;
+	bool m_stopping = false;
+	bool m_started = false;
+
+	bool m_setting_saved = false;
+	bool m_had_old_setting = false;
+	std::string m_old_setting;
+	std::string m_shutdown_message;
+};
